# Qwen / DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_MAX_RETRIES=1
# 默认直连 DashScope，避免失效的系统代理导致 TLS EOF；需要代理时改为 true
QWEN_TRUST_ENV=false
# 模型中心：模型档案只保存模型元数据，密钥和地址通过环境变量引用。
MODEL_REGISTRY_STORE_PATH=
MODEL_ROUTING_ENABLED=true
MAX_AGENT_STEPS=30
MAX_RAGFLOW_CALLS=1
# 多数据源统一搜索。只有配置了对应连接器凭据的来源会实际调用。
UNIFIED_SEARCH_ENABLED=true
UNIFIED_SEARCH_TOP_K=12
UNIFIED_SEARCH_TIMEOUT_SECONDS=8
# 有图谱/业务 API 配置时建议开启；也可以通过请求 source_types 显式触发。
UNIFIED_SEARCH_PREFETCH_ENABLED=false
SEARCH_SOURCES=document,qa,graph,sql,api,mcp
SEARCH_MAX_PARALLEL=4
QA_DATA_PATH=
BUSINESS_API_BASE_URL=
BUSINESS_API_TOKEN=
BUSINESS_API_TIMEOUT_SECONDS=8
SQL_SEARCH_URL=
# Optional dedicated gateway credential. Leave empty to reuse BUSINESS_API_TOKEN.
SQL_SEARCH_TOKEN=
SQL_SEARCH_TIMEOUT_SECONDS=8
SQL_SEARCH_MAX_ROWS=100
MCP_SEARCH_URL=
MCP_SEARCH_TOKEN=
# 图谱可选：neo4j 驱动按需安装，未配置时不会影响应用启动。
GRAPH_PROVIDER=none
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# 仅在受控导入任务需要调用 /api/graph/upsert 时设置；留空则禁止写入。
GRAPH_WRITE_TOKEN=
# 写入动作由策略层控制，默认先确认，高风险动作进入审批。
WRITE_ACTION_DEFAULT=confirm
HIGH_RISK_ACTION_DEFAULT=approval
AUDIT_LOG_ENABLED=true
RAGFLOW_TOP_K=4
# RAGFlow 调用重排模型前的内部候选池；最终返回数仍由 RAGFLOW_TOP_K 控制。
# 不要无界增大，RAGFlow 会按 page_size 向上取整重排窗口。
RAGFLOW_RETRIEVAL_TOP_K=24
RAGFLOW_CHUNK_MAX_CHARS=2200
RAGFLOW_CATALOG_TIMEOUT_SECONDS=5
# RAGFlow 模型 ID 必须匹配租户中的实例名和 provider；请以 /api/v1/models 返回值为准。
RAGFLOW_RERANK_ID=qwen3-rerank@千问@Tongyi-Qianwen
# 事实问答逐条生成声明并由第二次模型调用裁判证据状态。
CLAIM_VALIDATION_ENABLED=true
CLAIM_MAX_ITEMS=12
REQUIREMENT_MAX_ITEMS=12
REQUIREMENT_MAX_PARALLEL_SEARCHES=4
REQUIREMENT_PLAN_AUDIT_ENABLED=true
# Answer assembly: the model composes a natural answer from judged claims;
# the backend performs claim-level source-integrity checks instead of replacing
# a valid answer with a deterministic audit table.
ANSWER_ASSEMBLY_MODE=claim_level
# soft：绑定格式异常时保留已由需求裁判支持的自然回答；hard：异常时回退安全结果。
ANSWER_GATE_MODE=soft
ANSWER_REPAIR_MAX_ATTEMPTS=1

# RAGFlow source mode
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
# Optional: restrict retrieval to selected datasets, comma-separated.
RAGFLOW_DATASET_IDS=
# true 浠呭湪娌℃湁閰嶇疆浠讳綍 dataset ID 鏃惰嚜鍔ㄥ彂鐜板叏閮ㄧ煡璇嗗簱锛?# 閰嶇疆浜?RAGFLOW_DATASET_ID(S) 鍚庯紝绯荤粺濮嬬粓鍙绱㈣繖浜涚粦瀹氱殑鐭ヨ瘑搴撱€?RAGFLOW_AUTO_DISCOVER_DATASETS=false
# Evidence mode: off disables backend evidence/completeness gates; generic
# applies general gates; industrial_strict adds device field-level gates.
EVIDENCE_MODE=industrial_strict
# Similarity is only a candidate-generation signal, never proof by itself.
EVIDENCE_MIN_SIMILARITY=0.2
EVIDENCE_GENERIC_MIN_SIMILARITY=0.3
# Conversation context
# If Redis requires a password, use redis://:password@localhost:6379/2
REDIS_URL=redis://localhost:6379/2
CONTEXT_MAX_MESSAGES=12
MAX_CONVERSATIONS=10
CONVERSATION_TTL_SECONDS=604800

# Web service
APP_HOST=127.0.0.1
APP_PORT=8000
# 工作流编排定义；留空使用 app/data/workflows.json
WORKFLOW_STORE_PATH=
APPLICATION_STORE_PATH=
# 业务词典定义；留空使用 app/data/dictionaries.json。生产环境可由存储适配器接管。
DICTIONARY_STORE_PATH=
# Tool center: SQLite definitions/versions/actions/audit. Empty uses app/data.
TOOL_CENTER_DB_PATH=
# Local development ONLY; set false before any shared/production deployment.
TOOL_CENTER_LOCAL_ADMIN=true
# Comma-separated Fernet keys, newest first. Generate privately; never commit.
TOOL_CENTER_ENCRYPTION_KEYS=
# JSON array: token (32+ random chars), user_id, roles, workspaces, permissions.
# Roles: admin/editor/operator/approver/viewer. No client-supplied role headers.
TOOL_CENTER_AUTH_TOKENS=[]
# Explicit enterprise endpoint hostnames/IPs; redirects are always rejected.
TOOL_CENTER_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal
TOOL_CENTER_SESSION_HOURS=8
TOOL_CENTER_CONFIRMATION_MINUTES=15
